{
  "name": "maree",
  "private": true,
  "version": "1.1.6",
  "description": "Marée — a local-first mathematical problem library and proof-practice workspace.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:web": "node scripts/copy-pdfjs-assets.mjs",
    "build:web": "tsc --noEmit && vite build --outDir dist-web",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "e2e": "node scripts/e2e-acceptance.mjs",
    "e2e:phone": "node scripts/e2e-phone.mjs",
    "build:apk": "node scripts/build-apk.mjs",
    "release": "node scripts/release.mjs",
    "fixtures": "node scripts/build-fixtures.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.14",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "html-to-image": "^1.11.11",
    "jszip": "^3.10.2",
    "katex": "~0.16.47",
    "lucide-react": "^1.55.0",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "~5.7.284",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "~5.2.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vitest": "~4.1.11"
  }
}
